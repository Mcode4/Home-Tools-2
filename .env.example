# Project-wide Port Configuration
# Changes to these ports require a restart of both Docker and the Frontend Dev Server
FRONTEND=3000
BACKEND=8888
BACKEND_INTERNAL_PORT=8000
ADMINER=8881

# Backend Configuration
POSTGRES_URL=postgresql://user:password@localhost:5432/home_tools
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PROJECT_ENV=development

# Umami Analytics
APP_SECRET=change-me-for-umami-analytics